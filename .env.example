TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENAI_API_KEY=your-openai-api-key
# Optional: set only for a custom OpenAI-compatible endpoint (not required for direct OpenAI API)
# OPENAI_BASE_URL=https://your-compatible-endpoint.example/v1
OPENAI_MODEL=your-chat-model
EMBEDDING_MODEL=your-embedding-model
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index
PINECONE_NAMESPACE=haystack-team-chat-homework
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
# Used only by scripts/smoke_test_retrieval.py; the bot's summaries do not use top-k retrieval
RETRIEVAL_TOP_K=50
# Haystack telemetry is on by default. To disable it, set HAYSTACK_TELEMETRY_ENABLED=False in the
# shell environment that starts the bot; putting it in this file is too late.
